{
  "name": "flume",
  "version": "0.0.1",
  "description": "A workflow tool for agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "flume": "bin/flume.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "spec": "node scripts/spec-check.js",
    "check": "npm run typecheck && npm run lint && npm run test && npm run spec",
    "flume": "node bin/flume.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.1.0",
    "commander": "^15.1.0",
    "yaml": "^2.9.1"
  }
}
